{
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/spotlight",
      "schedule": "0 12 * * 1"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.marquee.bio"
        }
      ],
      "destination": "https://marquee.bio/:path*",
      "permanent": true
    }
  ]
}
